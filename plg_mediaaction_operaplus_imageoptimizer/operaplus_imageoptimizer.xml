<?xml version="1.0" encoding="UTF-8"?>
<extension type="plugin" group="media-action" method="upgrade">
 <name>PLG_MEDIA_ACTION_OPERAPLUS_IMAGEOPTIMIZER</name><version>1.1.1</version><creationDate>2026-11-27</creationDate>
 <author>Jecko Development</author><license>GNU General Public License version 2 or later</license>
 <description>PLG_MEDIA_ACTION_OPERAPLUS_IMAGEOPTIMIZER_XML_DESCRIPTION</description>
 <namespace path="src">OperaPlus\Plugin\MediaAction\ImageOptimizer</namespace>
 <files><folder plugin="operaplus_imageoptimizer">services</folder><folder>src</folder></files>
 <languages><language tag="en-GB">language/en-GB/plg_media-action_operaplus_imageoptimizer.ini</language><language tag="en-GB">language/en-GB/plg_media-action_operaplus_imageoptimizer.sys.ini</language><language tag="it-IT">language/it-IT/plg_media-action_operaplus_imageoptimizer.ini</language><language tag="it-IT">language/it-IT/plg_media-action_operaplus_imageoptimizer.sys.ini</language></languages>
 <config><fields name="params"><fieldset name="basic">
 <field name="convert_jpeg" type="radio" layout="joomla.form.field.radio.switcher" default="1" label="PLG_OPIMG_JPEG"><option value="0">JNO</option><option value="1">JYES</option></field>
 <field name="convert_png" type="radio" layout="joomla.form.field.radio.switcher" default="1" label="PLG_OPIMG_PNG"><option value="0">JNO</option><option value="1">JYES</option></field>
 <field name="quality" type="number" default="90" min="50" max="100" step="1" label="PLG_OPIMG_QUALITY"/>
 <field name="max_edge" type="list" default="1920" label="PLG_OPIMG_EDGE"><option value="1200">1200 px</option><option value="1600">1600 px</option><option value="1920">1920 px</option><option value="2560">2560 px</option><option value="0">PLG_OPIMG_NO_RESIZE</option></field>
 <field name="excluded_folders" type="textarea" rows="5" default="images/logos&#10;images/branding" label="PLG_OPIMG_EXCLUDED" description="PLG_OPIMG_EXCLUDED_DESC" filter="string"/>
 </fieldset></fields></config>
</extension>
