<?xml version="1.0" encoding="utf-8"?>
<extension type="module" client="site" method="upgrade">
  <name>MOD_OPERAPLUS_ATLAS</name><version>1.0.2</version>
  <creationDate>2026-11-26</creationDate><author>Jecko Development</author><license>GNU General Public License version 2 or later</license>
  <description>MOD_OPERAPLUS_ATLAS_XML_DESCRIPTION</description>
  <files><filename module="mod_operaplus_atlas">mod_operaplus_atlas.php</filename><folder>tmpl</folder><folder>language</folder></files>
  <media destination="mod_operaplus_atlas" folder="media"><folder>css</folder></media>
  <config><fields name="params"><fieldset name="basic">
    <field name="mode" type="list" default="context" label="MOD_OPERAPLUS_ATLAS_MODE"><option value="context">MOD_OPERAPLUS_ATLAS_CONTEXT</option><option value="manual">MOD_OPERAPLUS_ATLAS_MANUAL</option></field>
    <field name="field_name" type="text" default="atlas-entities" label="MOD_OPERAPLUS_ATLAS_FIELD" showon="mode:context"/>
    <field name="primary_field" type="text" default="atlas-primary" label="MOD_OPERAPLUS_ATLAS_PRIMARY" showon="mode:context"/>
    <field name="references" type="textarea" label="MOD_OPERAPLUS_ATLAS_REFERENCES" showon="mode:manual" filter="string"/>
    <field name="show_all" type="radio" default="0" label="MOD_OPERAPLUS_ATLAS_ALL" layout="joomla.form.field.radio.switcher"><option value="0">JNO</option><option value="1">JYES</option></field>
    <field name="hide_empty" type="radio" default="1" label="MOD_OPERAPLUS_ATLAS_HIDE" layout="joomla.form.field.radio.switcher"><option value="0">JNO</option><option value="1">JYES</option></field>
    <field name="cache" type="hidden" default="0"/>
  </fieldset><fieldset name="advanced"><field name="layout" type="modulelayout" label="JFIELD_ALT_LAYOUT_LABEL"/><field name="moduleclass_sfx" type="text" label="COM_MODULES_FIELD_MODULECLASS_SFX_LABEL"/></fieldset></fields></config>
</extension>
